<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked + Pressed -->
    <item android:state_checked="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/toggle_dark_checked_pressed" />
            <stroke android:width="2dp" android:color="@color/accent_cyan" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>

    <!-- Checked + Focused -->
    <item android:state_checked="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="#1b4d6e" />
            <stroke android:width="2dp" android:color="@color/accent_cyan" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>

    <!-- Checked (Normal ON) -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/toggle_dark_checked" />
            <stroke android:width="2dp" android:color="@color/toggle_dark_checked_stroke" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>

    <!-- Unchecked + Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/toggle_dark_unchecked_pressed" />
            <stroke android:width="1dp" android:color="@color/accent_cyan" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>

    <!-- Unchecked + Focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/btn_dark_focused" />
            <stroke android:width="1dp" android:color="@color/accent_cyan" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>

    <!-- Unchecked + Disabled -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/btn_dark_disabled" />
            <stroke android:width="1dp" android:color="#1a1f36" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>

    <!-- Unchecked (Normal OFF) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="@color/toggle_dark_unchecked" />
            <stroke android:width="1dp" android:color="@color/toggle_dark_unchecked_stroke" />
            <padding android:left="14dp" android:top="8dp" android:right="14dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
